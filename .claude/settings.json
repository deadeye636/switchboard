{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/guard-commands.js"],
            "timeout": 10,
            "statusMessage": "Checking the command"
          }
        ]
      }
    ]
  }
}
