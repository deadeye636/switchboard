{
  "name": "switchboard",
  "version": "0.7.14",
  "private": true,
  "license": "MIT",
  "description": "A desktop app for browsing, searching, and managing CLI coding sessions",
  "author": "Doctly <support@doctly.ai>",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/gen-build-info.js && npm run bundle:codemirror && npm run bundle:pdf && electron .",
    "start:debug": "node scripts/check-debug-port.js && node scripts/gen-build-info.js && npm run bundle:codemirror && npm run bundle:pdf && electron --remote-debugging-port=9222 .",
    "demo:start": "node scripts/demo-start.js",
    "demo:seed": "node scripts/seed-demo.js",
    "demo:auth": "node scripts/demo-auth.js",
    "test": "node --test --test-timeout=60000",
    "electron": "electron .",
    "stop:dev": "node scripts/stop-dev.js",
    "bundle:codemirror": "esbuild src/renderer/jsonl/codemirror-setup.js --bundle --outfile=src/renderer/codemirror-bundle.js --format=iife --platform=browser --minify",
    "bundle:pdf": "esbuild src/renderer/views/pdf-setup.js --bundle --outfile=src/renderer/pdf-bundle.js --format=iife --platform=browser --minify && esbuild node_modules/pdfjs-dist/build/pdf.worker.mjs --bundle --outfile=src/renderer/pdf-worker.js --format=iife --platform=browser --minify",
    "generate-icons": "node scripts/generate-icons.js && node scripts/generate-dmg-background.js",
    "upstream:check": "node scripts/upstream-check.js",
    "upstream:seen": "node scripts/upstream-check.js --seen",
    "hermes:help-check": "node scripts/check-hermes-help.js",
    "claude:help-check": "node scripts/check-claude-help.js",
    "codex:help-check": "node scripts/check-codex-help.js",
    "pi:help-check": "node scripts/check-pi-help.js",
    "agy:help-check": "node scripts/check-agy-help.js",
    "backends:help-check": "npm run claude:help-check && npm run codex:help-check && npm run hermes:help-check && npm run pi:help-check && npm run agy:help-check",
    "build": "node scripts/gen-build-info.js && npm run bundle:codemirror && npm run bundle:pdf && electron-builder",
    "build:mac": "node scripts/gen-build-info.js && npm run bundle:codemirror && npm run bundle:pdf && electron-builder --mac && node scripts/postinstall.js && codesign --sign - --force --deep dist/mac-arm64/Switchboard.app 2>/dev/null; true",
    "build:mac:arm64": "electron-builder --mac --arm64 2>/dev/null; true",
    "build:win": "node scripts/gen-build-info.js && npm run bundle:codemirror && npm run bundle:pdf && electron-builder --win",
    "build:linux": "node scripts/gen-build-info.js && npm run bundle:codemirror && npm run bundle:pdf && electron-builder --linux",
    "release": "node scripts/gen-build-info.js && npm run bundle:codemirror && npm run bundle:pdf && electron-builder --publish always",
    "postinstall": "patch-package && node scripts/postinstall.js && node scripts/ensure-conpty-dll.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "dompurify": "^3.4.12",
    "electron-log": "^5.4.4",
    "js-yaml": "4.3.1",
    "marked": "^18.0.7",
    "morphdom": "^2.7.8",
    "node-pty": "^1.2.0-beta.14",
    "pdfjs-dist": "^6.2.108",
    "smol-toml": "^1.8.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.43.7",
    "@ddietr/codemirror-themes": "^1.5.2",
    "@napi-rs/canvas": "^1.0.3",
    "codemirror": "^6.0.2",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "png2icons": "^2.0.1"
  },
  "overrides": {
    "node-gyp": "13.0.0",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "js-yaml@4": "4.3.1"
  },
  "build": {
    "appId": "ai.doctly.switchboard",
    "productName": "Switchboard",
    "beforePack": "scripts/ensure-conpty-dll.js",
    "files": [
      "src/**/*",
      "build-info.json",
      "build/icon.*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/node-pty/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "deadeye636",
      "repo": "switchboard"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "icon": "build/icons",
      "category": "Development"
    },
    "pacman": {
      "packageName": "switchboard-doctly",
      "artifactName": "switchboard-doctly-${version}.${ext}",
      "depends": [
        "gtk3",
        "nss",
        "libnotify",
        "libxtst",
        "libxss",
        "xdg-utils",
        "libsecret"
      ]
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 170
        },
        {
          "x": 490,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
